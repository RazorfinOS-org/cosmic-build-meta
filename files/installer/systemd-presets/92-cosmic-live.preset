# Live env presets. Only effective in oci/cosmic-live and
# oci/cosmic-nvidia-live (where systemctl preset-all runs at image
# assembly via installer/live-image-*.bst).

# Disable the OS-wide flatpak preinstall service for the live env.
# flatpak-preinstall.service runs `flatpak preinstall` to materialise
# everything in /usr/share/flatpak/preinstall.d/ -- Firefox plus the
# curated non-Steam gaming set (Lutris/Heroic/Bottles/Proton tools/GOverlay)
# would need many GB under /var/lib/flatpak. The live env's overlay tmpfs
# is intentionally small, and these apps are dead weight in a 30-minute
# installer session; the *installed* system handles the preinstall on its
# own.
disable flatpak-preinstall.service
